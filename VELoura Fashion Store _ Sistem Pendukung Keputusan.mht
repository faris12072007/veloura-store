Content-Location: https://fluffy-semifreddo-b2b36f.netlify.app/style.css

@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap");

:root { --burgundy: #641d35; --burgundy-dark: #431324; --rose: #ead8dc; --cream: #faf7f4; --white: #ffffff; --text: #35272c; --muted: #8a7b80; --border: #eee4e6; }

* { box-sizing: border-box; }

body { margin: 0px; font-family: "DM Sans", sans-serif; background: var(--cream); color: var(--text); }

.sidebar { width: 245px; height: 100vh; position: fixed; left: 0px; top: 0px; background: var(--burgundy-dark); color: white; padding: 30px 18px; display: flex; flex-direction: column; }

.brand { text-align: center; padding: 8px 0px 38px; }

.brand h2 { font: 700 34px "Playfair Display", serif; letter-spacing: 1px; margin: 0px; }

.brand span { font-size: 9px; letter-spacing: 4px; color: rgb(217, 185, 195); }

nav { display: grid; gap: 9px; }

.nav-link { border: 0px; color: rgb(232, 216, 221); background: transparent; text-align: left; padding: 14px 16px; border-radius: 8px; cursor: pointer; font: 500 14px "DM Sans", sans-serif; }

.nav-link:hover, .nav-link.active { background: rgb(120, 51, 75); color: white; }

.sidebar-bottom { margin-top: auto; padding: 18px 8px 0px; border-top: 1px solid rgb(121, 80, 93); font-size: 12px; line-height: 1.8; }

.sidebar-bottom small { color: rgb(201, 174, 183); }

.main { margin-left: 245px; padding: 30px 38px; min-height: 100vh; }

.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26px; }

h1 { font: 700 28px "Playfair Display", serif; margin: 3px 0px; }

.eyebrow { color: rgb(152, 100, 119); letter-spacing: 2px; font-size: 10px; font-weight: 700; margin: 0px 0px 7px; }

.top-date { color: var(--muted); font-size: 13px; }

.page { display: none; }

.page.active { display: block; }

.welcome { background: linear-gradient(115deg, rgb(74, 20, 40), rgb(129, 47, 77)); border-radius: 15px; padding: 35px 38px; color: white; display: flex; justify-content: space-between; align-items: center; min-height: 190px; overflow: hidden; }

.welcome h2 { font: 700 29px "Playfair Display", serif; margin: 8px 0px; }

.welcome p:last-child { color: rgb(234, 217, 223); font-size: 13px; }

.eyebrow.light { color: rgb(226, 186, 200); }

.welcome-mark { font: 700 130px / 1 "Playfair Display", serif; color: rgba(255, 255, 255, 0.125); padding-right: 15px; }

.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 22px 0px; }

.stat-card, .panel { background: white; border: 1px solid var(--border); border-radius: 12px; box-shadow: rgba(72, 32, 50, 0.03) 0px 4px 18px; }

.stat-card { padding: 21px; }

.stat-card span { color: var(--muted); font-size: 12px; display: block; }

.stat-card strong { display: block; font: 700 25px "Playfair Display", serif; color: var(--burgundy); margin-top: 9px; }

.panel { padding: 25px; margin-bottom: 22px; }

.panel-heading { display: flex; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 20px; }

.panel-heading h3 { font: 700 21px "Playfair Display", serif; margin: 0px; }

.primary-btn { background: var(--burgundy); color: white; border: 0px; padding: 11px 17px; border-radius: 7px; cursor: pointer; font: 600 12px "DM Sans", sans-serif; }

.primary-btn:hover { background: var(--burgundy-dark); }

.table-wrap { width: 100%; overflow-x: auto; }

table { width: 100%; border-collapse: collapse; font-size: 12px; }

th { background: rgb(247, 239, 241); color: var(--burgundy); font-weight: 700; text-align: left; white-space: nowrap; }

th, td { padding: 13px 12px; border-bottom: 1px solid var(--border); }

td { color: rgb(85, 70, 75); }

tbody tr:hover { background: rgb(253, 250, 251); }

input, select { font: 12px "DM Sans", sans-serif; border: 1px solid rgb(229, 215, 220); border-radius: 6px; padding: 9px; color: var(--text); background: white; }

input:focus, select:focus { outline: rgb(234, 209, 218) solid 2px; border-color: var(--burgundy); }

.table-input { width: 100%; min-width: 90px; }

.action-btn { border: 0px; border-radius: 5px; background: rgb(245, 233, 237); color: var(--burgundy); padding: 7px 10px; cursor: pointer; }

.help { color: var(--muted); font-size: 12px; line-height: 1.7; margin: 0px 0px 18px; }

.weight-total { text-align: right; padding: 18px 5px 0px; color: var(--burgundy); }

.sop-toolbar { display: flex; align-items: center; gap: 12px; margin: 20px 0px; flex-wrap: wrap; }

.sop-toolbar label { font-size: 12px; font-weight: 700; }

.sop-toolbar select { min-width: 200px; }

.sop-summary { margin-left: auto; background: rgb(247, 239, 241); color: var(--burgundy); border-radius: 7px; padding: 10px 14px; font-size: 12px; font-weight: 700; }

.sop-wrap { max-width: 100%; }

.sop-table { min-width: 1550px; }

.sop-table th, .sop-table td { text-align: center; padding: 9px 5px; }

.sop-table th:first-child, .sop-table td:first-child { text-align: left; min-width: 190px; position: sticky; left: 0px; background: rgb(255, 255, 255); z-index: 1; }

.sop-table thead th:first-child { background: rgb(247, 239, 241); }

.sop-input { width: 43px; min-width: 43px; padding: 7px 3px; text-align: center; }

.compliance-row td { background: rgb(251, 245, 247); font-weight: 700; color: var(--burgundy); }

h4 { color: var(--burgundy); margin: 25px 0px 12px; font-size: 14px; }

footer { color: rgb(161, 142, 149); text-align: center; padding: 20px 0px 5px; font-size: 11px; }

@media (max-width: 900px) {
  .sidebar { width: 190px; padding: 20px 12px; }
  .main { margin-left: 190px; padding: 22px; }
  .stats { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .sidebar { position: relative; width: 100%; height: auto; }
  nav { grid-template-columns: repeat(2, 1fr); }
  .sidebar-bottom { display: none; }
  .main { margin-left: 0px; padding: 17px; }
  .stats { grid-template-columns: repeat(2, 1fr); }
  .welcome { padding: 25px; }
  .welcome-mark { display: none; }
  .panel { padding: 16px; }
}

